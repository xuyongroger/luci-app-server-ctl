#!/usr/bin/ucode

'use strict';

import { readfile, writefile } from 'fs';
import core from '/usr/share/serverctl/core.uc';

function readnow() {
	/* 用 ucode 内置 localtime() 进程内计算，不再每 3 秒 fork 一个 date；
	 * localtime 跟随 TZ 环境变量（procd start_service 注入 /etc/TZ）。
	 * 注意 TimeSpec：mon 为 1 基；wday 为 0 基（周日=0，与 date +%w 及前端
	 * weekday 取值一致；tick() 侧另有 7→0 兼容旧数据）。 */
	const t = localtime();

	if (t == null)
		return null;

	return {
		date: sprintf('%04d-%02d-%02d', t['year'], t['mon'], t['mday']),
		hour: t['hour'],
		minute: t['min'],
		weekday: t['wday'],
	};
}

function tick() {
	const ctx = core.get_cursor();
	const results = [];
	const nowinfo = readnow();

	if (nowinfo == null)
		return results;

	ctx.load('serverctl');

	if (core.str(ctx.get('serverctl', 'defaults', 'enabled') ?? '1') == '0')
		return results;

	const all = ctx.get_all('serverctl');
	let deleted = false;

	if (all == null)
		return results;

	for (let sid in all) {
		const s = all[sid];
		let wd;

		if (s['.type'] != 'task')
			continue;

		if (core.str(s['enabled'] ?? '1') == '0')
			continue;

		if (int(core.str(s['hour'])) != nowinfo.hour)
			continue;

		if (int(core.str(s['minute'])) != nowinfo.minute)
			continue;

		const schedule = core.str(s['schedule'] ?? 'daily');

		if (schedule == 'weekly') {
			wd = int(core.str(s['weekday']));

			if (wd == 7)
				wd = 0;

			if (wd != nowinfo.weekday)
				continue;
		}
		else if (schedule == 'once') {
			if (core.str(s['date'] ?? '') != nowinfo.date)
				continue;
		}
		else if (schedule != 'daily') {
			continue;
		}

		const action = core.str(s['action'] ?? '');

		if (action == '' || core.str(s['server'] ?? '') == '')
			continue;

		const res = core.execute(action, core.str(s['server']));

		push(results, sprintf('%s %s %s code=%d output=%s',
			sid, core.str(s['server']), action, res.code, trim(res.output)));

		if (schedule == 'once') {
			ctx.delete('serverctl', sid);
			deleted = true;
		}
	}

	if (deleted)
		ctx.commit('serverctl');

	return results;
}

if (length(ARGV) > 0 && ARGV[0] == 'tick') {
	const results = tick();

	for (let line in results)
		printf('%s\n', line);

	exit(0);
}

/* “最近已处理分钟”落盘 /var/run(tmpfs)：respawn/服务重启后不再重复执行同一分钟
 * 内已触发的任务；/var/run 随重启清空，重启后当前分钟任务照常至多执行一次 */
const LASTFILE = '/var/run/serverctl-lasttick';

let last = trim(core.str(readfile(LASTFILE) ?? ''));

while (true) {
	const nowinfo = readnow();

	if (nowinfo != null) {
		const stamp = sprintf('%s %02d:%02d', nowinfo.date, nowinfo.hour, nowinfo.minute);

		if (stamp != last) {
			last = stamp;
			writefile(LASTFILE, stamp);

			/* 将定时执行结果写到 stdout，procd 的 stdout 重定向会将其收入 logread */
			for (let line in tick())
				printf('%s\n', line);
		}
	}

	sleep(3000);
}
